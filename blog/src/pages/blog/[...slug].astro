---
import BlogPost from '../../layouts/BlogPost.astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { getRelatedPosts } from '../../utils/related-posts';
import { getReadingTime } from '../../utils/reading-time';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, related: getRelatedPosts(post, posts, 3) },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  related: CollectionEntry<'blog'>[];
}

const { post, related } = Astro.props;
const { Content, headings } = await post.render();
const readingTime = getReadingTime(post.body);
---

<BlogPost post={post} related={related} readingTime={readingTime} headings={headings}>
  <Content />
</BlogPost>
