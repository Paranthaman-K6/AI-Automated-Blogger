---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterCTA from '../components/NewsletterCTA.astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { tagSlug, collectTags } from '../utils/tags';
import { getReadingTime } from '../utils/reading-time';

const posts = await getCollection('blog');
const sortedPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const topTags = collectTags(posts).slice(0, 12);
---

<BaseLayout title="Home" description="Welcome to Automated Blogger - Latest posts">
  <section class="hero">
    <div class="hero-content">
      <h1>Automated Blogger</h1>
      <p class="hero-tagline">High-performance technical blogging powered by AI and Astro.</p>
    </div>
  </section>

  {topTags.length > 0 && (
    <section class="tags-strip">
      <span class="tags-strip-label">Browse:</span>
      {topTags.map(({ tag, slug }) => (
        <a class="tag tag-link" href={`/tags/${slug}`}>#{tag}</a>
      ))}
      <a class="tags-all" href="/tags">All tags →</a>
    </section>
  )}

  <section class="posts-grid">
    {sortedPosts.map((post) => (
      <article class="post-preview" key={post.id}>
        <a class="post-link" href={`/blog/${post.slug}`}>
          <h2 class="post-title">{post.data.title}</h2>
          <p class="post-description">{post.data.description}</p>
        </a>
        <div class="post-meta">
          <time datetime={post.data.pubDate.toISOString()}>
            {new Intl.DateTimeFormat('en-US', { dateStyle: 'medium' }).format(post.data.pubDate)}
          </time>
          <span class="meta-sep">&bull;</span>
          <span class="author">By {post.data.author}</span>
          <span class="meta-sep">&bull;</span>
          <span>{getReadingTime(post.body)} min read</span>
        </div>
        {
          post.data.tags && post.data.tags.length > 0 && (
            <div class="tags">
              {post.data.tags.map((tag) => (
                <a class="tag tag-link" href={`/tags/${tagSlug(tag)}`}>#{tag}</a>
              ))}
            </div>
          )
        }
      </article>
    ))}
  </section>

  <NewsletterCTA title="Stay Updated" description="Never miss a new post. Subscribe to get notified when we publish new technical deep-dives." />
</BaseLayout>

<style>
  :root {
    --max-w: 1400px;
  }
  .hero {
    text-align: center;
    padding: 4rem 0 3rem;
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
    border-radius: 1rem;
    margin-bottom: 2rem;
  }
  .hero-content {
    max-width: 640px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .hero h1 {
    font-size: 2.75rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }
  .hero-tagline {
    color: #64748b;
    font-size: 1.125rem;
    max-width: 520px;
    margin: 0 auto;
    line-height: 1.6;
  }
  .tags-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
    padding: 1rem 0;
  }
  .tags-strip-label {
    font-size: 0.875rem;
    font-weight: 700;
    color: #64748b;
    margin-right: 0.25rem;
  }
  .tags-all {
    font-size: 0.875rem;
    font-weight: 600;
    color: #4f46e5;
    text-decoration: none;
    margin-left: 0.25rem;
  }
  .tags-all:hover {
    text-decoration: underline;
  }
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
    margin: 0 0 2rem 0;
  }
  .post-preview {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 0.75rem;
    overflow: hidden;
    padding: 1.75rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.15s ease;
  }
  .post-preview:hover {
    border-color: #818cf8;
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.1);
    transform: translateY(-2px);
  }
  .post-preview a {
    text-decoration: none;
    color: inherit;
  }
  .post-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
    color: #0f172a;
    line-height: 1.4;
  }
  .post-link:hover .post-title {
    color: #4f46e5;
  }
  .post-description {
    color: #475569;
    font-size: 0.925rem;
    line-height: 1.6;
    margin: 0 0 1rem 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: #64748b;
    margin-bottom: 0.75rem;
  }
  .meta-sep {
    margin: 0;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .tag {
    background-color: #f1f5f9;
    color: #475569;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    border-radius: 9999px;
    display: inline-block;
  }
  .tag-link:hover {
    background-color: #e0e7ff;
    color: #4f46e5;
  }
</style>
