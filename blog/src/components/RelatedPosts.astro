---
import type { CollectionEntry } from 'astro:content';
interface Props { posts: CollectionEntry<'blog'>[]; }
const { posts } = Astro.props;
function formatDate(d: Date) { return new Intl.DateTimeFormat('en-US', { dateStyle: 'medium' }).format(new Date(d)); }
---
{posts.length > 0 && (<div class="related-posts"><h3 class="sidebar-section-title">You may also like</h3><div class="related-list">{posts.map((p) => (<a class="related-card" href={`/blog/${p.slug}`}><span class="related-title">{p.data.title}</span><span class="related-desc">{p.data.description}</span><span class="related-meta">{formatDate(p.data.pubDate)}{p.data.tags?.length > 0 && ` · ${p.data.tags.slice(0, 2).join(', ')}`}</span></a>))}</div></div>)}
<style>
  .related-posts { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 0.75rem; padding: 1.25rem; }
  .sidebar-section-title { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b; margin: 0 0 0.75rem; }
  .related-list { display: flex; flex-direction: column; gap: 0.75rem; }
  .related-card { display: flex; flex-direction: column; gap: 0.3rem; border: 1px solid #e2e8f0; border-radius: 0.5rem; padding: 0.85rem 1rem; text-decoration: none; background: #ffffff; transition: border-color 0.15s, transform 0.15s, box-shadow 0.15s; }
  .related-card:hover { border-color: #818cf8; transform: translateX(3px); box-shadow: 0 2px 8px rgba(99,102,241,0.1); }
  .related-title { font-weight: 700; font-size: 0.875rem; color: #0f172a; line-height: 1.4; }
  .related-desc { font-size: 0.775rem; color: #64748b; line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .related-meta { font-size: 0.7rem; color: #94a3b8; margin-top: 0.2rem; }
</style>